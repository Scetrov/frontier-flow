{
  "name": "frontier-flow",
  "private": true,
  "version": "0.11.16",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Scetrov/frontier-flow.git"
  },
  "bugs": {
    "url": "https://github.com/Scetrov/frontier-flow/issues"
  },
  "scripts": {
    "dev": "vite",
    "dev:netlify": "bunx netlify dev",
    "debug:turret-priority-mcve": "bun run ./scripts/debug-turret-priority-mcve.ts",
    "debug:remote-deploy-grade-mcve": "bun run ./scripts/debug-remote-deploy-grade-mcve.ts",
    "build": "tsc -b && vite build",
    "build:with-world-contracts": "bun run fetch:world-contracts && bun run build",
    "commitlint": "commitlint",
    "debug:local-publish-mcve": "bun run ./scripts/debug-local-publish-mcve.ts",
    "fetch:sui-upstream-sources": "bun run ./scripts/fetch-sui-upstream-sources.ts",
    "fetch:world-contracts": "bun run ./scripts/fetch-world-contracts.ts",
    "lint": "oxlint .",
    "prepare": "husky",
    "preview": "vite preview",
    "test": "vitest",
    "test:functions": "vitest run netlify/functions/__tests__",
    "test:run": "vitest run && bun run test:security",
    "test:security": "node --test scripts/security/fast-uri-regression.mjs scripts/security/no-legacy-sui-jsonrpc.mjs scripts/security/source-map-js-regression.mjs",
    "test:coverage": "vitest run --coverage && bun run test:security",
    "test:e2e": "playwright test",
    "test:real-wasm": "bun run ./scripts/real-wasm-integration.ts",
    "check:world-package-references": "bun run ./scripts/check-world-package-references.ts",
    "typecheck": "tsc -b",
    "audit": "bunx npm-audit --audit-level=high",
    "verify": "bun run lint && bun run typecheck && bun run test:run",
    "validate:best-practices": "node scripts/validate-best-practices.mjs",
    "verify:full": "bun run verify && bun run build"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@netlify/functions": "^6.0.2",
    "@mysten/dapp-kit-core": "1.6.37",
    "@mysten/dapp-kit-react": "2.1.39",
    "@mysten/sui": "2.35.0",
    "@mysten/wallet-standard": "0.21.33",
    "@mysten/walrus": "1.2.34",
    "@tanstack/react-query": "^5.104.0",
    "@types/dagre": "^0.7.53",
    "@xyflow/react": "^12.12.0",
    "@zktx.io/sui-move-builder": "0.5.1",
    "dagre": "^0.8.5",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "autoprefixer": "^10.6.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "postcss": "^8.5.28",
    "rolldown-vite": "7.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "fast-uri": "3.1.8",
    "js-yaml": "4.3.2",
    "lodash": "4.18.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "picomatch": "4.0.4",
    "source-map-js": "1.2.2",
    "vite": "8.0.16"
  }
}
