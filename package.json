{
  "name": "frontier-flow",
  "private": true,
  "version": "0.11.9",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Scetrov/frontier-flow.git"
  },
  "bugs": {
    "url": "https://github.com/Scetrov/frontier-flow/issues"
  },
  "scripts": {
    "dev": "vite",
    "dev:netlify": "bunx netlify dev",
    "debug:turret-priority-mcve": "bun run ./scripts/debug-turret-priority-mcve.ts",
    "debug:remote-deploy-grade-mcve": "bun run ./scripts/debug-remote-deploy-grade-mcve.ts",
    "build": "tsc -b && vite build",
    "build:with-world-contracts": "bun run fetch:world-contracts && bun run build",
    "commitlint": "commitlint",
    "debug:local-publish-mcve": "bun run ./scripts/debug-local-publish-mcve.ts",
    "fetch:sui-upstream-sources": "bun run ./scripts/fetch-sui-upstream-sources.ts",
    "fetch:world-contracts": "bun run ./scripts/fetch-world-contracts.ts",
    "lint": "oxlint .",
    "prepare": "husky",
    "preview": "vite preview",
    "test": "vitest",
    "test:functions": "vitest run netlify/functions/__tests__",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:real-wasm": "bun run ./scripts/real-wasm-integration.ts",
    "check:world-package-references": "bun run ./scripts/check-world-package-references.ts",
    "typecheck": "tsc -b",
    "audit": "bunx npm-audit --audit-level=high",
    "verify": "bun run lint && bun run typecheck && bun run test:run",
    "validate:best-practices": "node scripts/validate-best-practices.mjs",
    "verify:full": "bun run verify && bun run build"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@netlify/functions": "^5.3.0",
    "@mysten/dapp-kit": "1.1.12",
    "@mysten/sui": "2.23.1",
    "@mysten/walrus": "^1.2.12",
    "@tanstack/react-query": "^5.101.4",
    "@types/dagre": "^0.7.53",
    "@xyflow/react": "^12.11.2",
    "@zktx.io/sui-move-builder": "0.5.1",
    "dagre": "^0.8.5",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.5.23",
    "rolldown-vite": "7.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "fast-uri": "3.1.4",
    "js-yaml": "4.3.0",
    "lodash": "4.18.1",
    "postcss": "8.5.25",
    "picomatch": "4.0.4",
    "vite": "8.0.16"
  }
}
