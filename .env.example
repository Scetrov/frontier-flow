# Frontier Flow — Environment Variables
# Copy this file to .env for local development: cp .env.example .env
# See docs/DEPLOYMENT.md §3.2 for details.

# Base URL path — only override for subpath deployments (e.g. GitHub Pages)
# VITE_BASE_PATH=/frontier-flow/

# GitHub OAuth App client ID for optional authenticated GitHub fetches
# VITE_GITHUB_CLIENT_ID=your_dev_client_id
# GITHUB_CLIENT_ID=your_dev_client_id

# Netlify function callback path override. Leave unset for the default route.
# VITE_GITHUB_AUTH_CALLBACK_PATH=/api/github-callback

# Optional for local Netlify Dev verification only. Do not commit real values.
# GITHUB_CLIENT_SECRET=your_netlify_dev_client_secret
